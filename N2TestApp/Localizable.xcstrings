        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abonnez-vous pour étudier tous les examens blancs et les notes d'erreurs en illimité."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berlangganan untuk mempelajari semua ujian tiruan dan catatan jawaban salah tanpa batas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "購読すると、すべての模擬試験と間違えた問題ノートを無制限に学習できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "구독 시 모든 모의고사 및 오답노트를 무제한으로 학습할 수 있습니다."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สมัครสมาชิกเพื่อเรียนรู้ข้อสอบจำลองและบันทึกคำตอบที่ผิดทั้งหมดได้อย่างไม่จำกัด"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đăng ký để học tất cả các bài thi thử và ghi chú câu trả lời sai không giới hạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "订阅后即可无限制地学习所有模拟考试和错题本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "訂閱後即可無限制地學習所有模擬考試和錯題本。"
          }
        }
      }
    },
